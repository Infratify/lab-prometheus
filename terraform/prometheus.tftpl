---
- name: Install Prometheus
  hosts: server
  become: true
  roles:
    - prometheus.prometheus.prometheus
  vars:
    prometheus_scrape_configs:
      - job_name: "prometheus"
        static_configs:
          - targets: ["${prometheus.public_ip}:9090"]

      - job_name: "node_exporter"
        static_configs:
          - targets: ["${prometheus_node_exporter.public_ip}:9100"]
